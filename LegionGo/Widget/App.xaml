<Application x:Class="LegionTweaks.Widget.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Dark">
  <Application.Resources>
    <!-- Adapted from ClawTweaks' Next Gen Claw theme; see ../SOURCES.md. -->
    <LinearGradientBrush x:Key="PageBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1626A8" Offset="0"/><GradientStop Color="#3E1A8E" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="CardBrush" Color="#D5283482"/>
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#3A8CFF"/>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="BorderBrush" Value="#6078E6"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style TargetType="Button"><Setter Property="MinHeight" Value="44"/><Setter Property="Margin" Value="0,4,6,4"/></Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="44"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  </Application.Resources>
</Application>
