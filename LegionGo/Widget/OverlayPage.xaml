<Page x:Class="LegionTweaks.Widget.OverlayPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
  <Border x:Name="Panel" Background="#ED101522" CornerRadius="8" Padding="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="5">
        <TextBlock Text="LEGIONTWEAKS · EN VIVO" FontSize="13" FontWeight="Bold" Foreground="#91C7FF"/>
        <TextBlock x:Name="Temperatures" Text="CPU N/D · GPU N/D" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock x:Name="Voltages" Text="Voltaje GPU N/D · SoC N/D" FontSize="16"/>
        <TextBlock x:Name="GpuLoad" Text="GPU N/D · N/D" FontSize="16"/>
        <TextBlock x:Name="Power" Text="Consumo GPU N/D · CPU N/D" TextWrapping="Wrap"/>
        <TextBlock x:Name="Asic" Text="ASIC (AMD) N/D"/>
        <Border BorderBrush="#556179" BorderThickness="0,1,0,0" Margin="0,3"/>
        <TextBlock x:Name="Limits" Text="Límites SPL / SPPT / FPPT: N/D" TextWrapping="Wrap"/>
        <TextBlock x:Name="Cooling" Text="Ventilador N/D · Batería N/D"/>
        <TextBlock x:Name="PowerSource" Text="Fuente de energía N/D"/>
        <TextBlock x:Name="SampleStatus" Text="Conectando…" FontSize="11" TextWrapping="Wrap" Foreground="#B6C4D8"/>
        <TextBlock x:Name="Hint" Text="Fija este overlay con la chincheta de arriba y cierra Win+G. N/D = sensor no disponible. Los límites no son consumo medido." FontSize="11" TextWrapping="Wrap" Foreground="#B6C4D8" Margin="0,4,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Page>
