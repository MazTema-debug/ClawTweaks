<Page x:Class="LegionTweaks.Widget.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBrush}">
  <Grid Padding="16" XYFocusKeyboardNavigation="Enabled">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="LegionTweaks Lab" FontSize="28" FontWeight="Bold"/>
      <TextBlock Text="LEGION GO · Z1 EXTREME · PORT EXPERIMENTAL" FontSize="11" Margin="0,4,0,10"/>
      <TextBlock x:Name="DeviceText" Text="Conectando…" TextWrapping="Wrap"/>
      <TextBlock x:Name="MetricsText" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,8,0,8">
      <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"/>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="13"/>
      <Button x:Name="RefreshButton" Content="Actualizar lecturas" Click="Refresh_Click"/>
      <Button Content="Abrir overlay del juego" Click="Overlay_Click"/>
    </StackPanel>
    <Pivot x:Name="Controls" Grid.Row="2" IsEnabled="False">
      <PivotItem Header="Potencia">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Modo Lenovo" Style="{StaticResource SectionTitle}"/>
              <ComboBox x:Name="ModeBox" AutomationProperties.Name="Modo de potencia Lenovo">
                <ComboBoxItem Content="Silencioso" Tag="1"/><ComboBoxItem Content="Equilibrado" Tag="2"/><ComboBoxItem Content="Rendimiento" Tag="3"/><ComboBoxItem Content="Personalizado" Tag="255"/>
              </ComboBox>
              <Button x:Name="ModeApply" Content="Aplicar modo" Click="Mode_Click"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Límites personalizados" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="TdpLive" TextWrapping="Wrap"/>
              <Slider x:Name="Spl" Header="SPL · potencia sostenida (W)" Minimum="5" Maximum="30" StepFrequency="1" Value="15"/>
              <Slider x:Name="Sppt" Header="SPPT · impulso corto (W)" Minimum="5" Maximum="30" StepFrequency="1" Value="15"/>
              <Slider x:Name="Fppt" Header="FPPT · pico (W)" Minimum="5" Maximum="30" StepFrequency="1" Value="15"/>
              <TextBlock Text="5 ≤ SPL ≤ SPPT ≤ FPPT ≤ 30 W. Aplicar activa el modo Personalizado." TextWrapping="Wrap" FontSize="12"/>
              <Button x:Name="Equalize" Content="Igualar SPPT y FPPT a SPL" Click="Equalize_Click"/>
              <Button x:Name="TdpApply" Content="Aplicar los tres límites" Click="Tdp_Click"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Perfiles de potencia" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Aplicación manual. Guardan únicamente SPL, SPPT y FPPT." TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
              <ComboBox x:Name="Profiles" DisplayMemberPath="Name" AutomationProperties.Name="Perfiles guardados"/>
              <Button Content="Aplicar perfil seleccionado" Click="ProfileApply_Click"/>
              <TextBox x:Name="ProfileName" Header="Nombre del nuevo perfil" MaxLength="40"/>
              <Button Content="Guardar los límites de los deslizadores" Click="ProfileSave_Click"/>
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem Header="CPU">
        <ScrollViewer><StackPanel>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Plan de energía activo" Style="{StaticResource SectionTitle}"/>
            <ComboBox x:Name="Source" SelectedIndex="0" SelectionChanged="Source_Changed" Header="Valores que deseas editar">
              <ComboBoxItem Content="Con cargador (AC)"/><ComboBoxItem Content="Con batería (DC)"/>
            </ComboBox>
            <TextBlock x:Name="CpuLive" TextWrapping="Wrap" Margin="0,8,0,8"/>
            <ToggleSwitch x:Name="Boost" Header="CPU Boost" OnContent="Activado" OffContent="Desactivado"/>
            <Button x:Name="BoostApply" Content="Aplicar Boost" Click="Boost_Click"/>
            <Slider x:Name="Epp" Header="EPP · 0 rendimiento / 100 ahorro" Minimum="0" Maximum="100" StepFrequency="1"/>
            <Button x:Name="EppApply" Content="Aplicar EPP" Click="Epp_Click"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Modo de energía Windows" Style="{StaticResource SectionTitle}"/>
            <ComboBox x:Name="OsMode" AutomationProperties.Name="Modo de energía Windows"><ComboBoxItem Content="Máxima eficiencia"/><ComboBoxItem Content="Equilibrado"/><ComboBoxItem Content="Máximo rendimiento"/></ComboBox>
            <Button x:Name="OsApply" Content="Aplicar modo Windows" Click="Os_Click"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </PivotItem>
      <PivotItem Header="Sistema">
        <ScrollViewer><StackPanel>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Ventilador y batería" Style="{StaticResource SectionTitle}"/>
            <ToggleSwitch x:Name="Fan" Header="Ventilador a máxima velocidad" OnContent="Máximo" OffContent="Automático"/>
            <Button x:Name="FanApply" Content="Aplicar ventilador" Click="Fan_Click"/>
            <ToggleSwitch x:Name="Charge" Header="Limitar carga al 80 %"/>
            <Button x:Name="ChargeApply" Content="Aplicar límite de carga" Click="Charge_Click"/>
            <ToggleSwitch x:Name="Light" Header="Luz del botón de encendido"/>
            <Button x:Name="LightApply" Content="Aplicar luz" Click="Light_Click"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Restaurar ajustes" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Recupera los valores que este port guardó antes de sus primeras modificaciones. El respaldo se conserva entre reinicios." TextWrapping="Wrap"/>
            <Button Content="Restaurar valores originales" Click="Restore_Click"/>
          </StackPanel></Border>
          <TextBlock Text="LegionTweaks Lab 0.1.4 · Basado en ClawTweaks y GoTweaks. Overlay de sensores disponible en Game Bar. Controladores, giroscopio, RGB de sticks y ajustes Radeon aún no integrados." TextWrapping="Wrap" FontSize="12" Margin="4,8"/>
        </StackPanel></ScrollViewer>
      </PivotItem>
    </Pivot>
  </Grid>
</Page>
