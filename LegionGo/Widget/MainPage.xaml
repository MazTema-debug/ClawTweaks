                  <ComboBox x:Name="LegionCaptureChoice" Header="Botón que vas a pulsar" IsEnabled="False" />
                  <Button x:Name="LegionCaptureStart" Content="Iniciar identificación (30 segundos)" Click="LegionCaptureStart_Click" IsEnabled="False" />
                  <Button x:Name="LegionCaptureCancel" Content="Cancelar identificación" Click="LegionCaptureCancel_Click" IsEnabled="False" />
                  <TextBlock x:Name="LegionCaptureText" Text="Consultando identificación de botones…" TextWrapping="Wrap" FontSize="12" IsTextSelectionEnabled="True" />
                </StackPanel>
              </local:DetailsCard>
            </Border>
            <Border Style="{StaticResource Card}">
              <local:DetailsCard Title="Mouse con stick derecho" Description="Abre las opciones y aplica los cambios con sus botones.">
                <StackPanel Spacing="8">
                  <TextBlock x:Name="MouseText" Text="Apagado. Requiere el mando virtual activo." TextWrapping="Wrap" />
                  <Button x:Name="MouseToggle" Content="Activar mouse con stick derecho" Click="MouseToggle_Click" IsEnabled="False" />
                  <Slider x:Name="MouseSensitivity" Header="Sensibilidad" Minimum="1" Maximum="20" Value="8" StepFrequency="1" />
                  <Slider x:Name="MouseDeadzone" Header="Zona muerta (%)" Minimum="5" Maximum="30" Value="15" StepFrequency="1" />
                  <Button x:Name="MouseSettings" Content="Aplicar ajustes del mouse" Click="MouseSettings_Click" IsEnabled="False" />
                  <TextBlock Text="Solo mueve el cursor con el virtual activo; consume el stick derecho para evitar mover también la cámara y no añade clics. Sensibilidad y zona muerta se conservan. Al activarlo, suelta el stick para armarlo. Siempre arranca apagado; también se apaga al devolver el físico, suspender o desconectar." TextWrapping="Wrap" FontSize="12" />
                  <TextBlock Text="Si otra aplicación también controla el cursor, desactiva esa función antes de usar este modo." TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
              </local:DetailsCard>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem Header="Perfiles" x:Name="ProfilesTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" BringIntoViewOnFocusChange="True">
          <StackPanel Padding="0,4,0,12">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Perfiles guardados" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Guardar conserva tus ajustes; Aplicar cambia el equipo. La selección es manual." TextWrapping="Wrap" />
                <ComboBox x:Name="Profiles" Header="Perfiles guardados" DisplayMemberPath="Name" SelectionChanged="ProfileSelection_Changed" />
                <Button x:Name="ProfileApplyButton" Content="Aplicar perfil guardado" Click="ProfileApply_Click" />
                <Button Content="Crear perfil nuevo" Click="ProfileNew_Click" />
                <TextBox x:Name="ProfileName" Header="Nombre (editarlo permite renombrar)" MaxLength="40" XYFocusKeyboardNavigation="Disabled" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                <Button x:Name="ProfileNameEditButton" Content="Editar nombre con teclado táctil" Click="ProfileNameEdit_Click" />
                <Button x:Name="ProfileSave" Content="Guardar cambios del perfil" Click="ProfileSave_Click" />
                <TextBlock x:Name="ProfileNotice" TextWrapping="Wrap" FontSize="12" />
                <TextBlock x:Name="ProfileDraftNotice" TextWrapping="Wrap" FontSize="12" />
                <local:DetailsCard Title="Gestionar perfiles" Description="Duplicar, comparar, importar, exportar o eliminar.">
                  <StackPanel>
                    <Button x:Name="ProfileDuplicate" Content="Duplicar perfil guardado como borrador" Click="ProfileDuplicate_Click" IsEnabled="False" />
                    <Button x:Name="ProfileCompare" Content="Comparar con otro perfil guardado" Click="ProfileCompare_Click" IsEnabled="False" />
                    <Button Content="Eliminar perfil seleccionado" Click="ProfileDelete_Click" />
                    <Button x:Name="ProfileExport" Content="Exportar perfiles a JSON" Click="ProfileExport_Click" IsEnabled="False" />
                    <Button x:Name="ProfileImport" Content="Importar copias desde JSON" Click="ProfileImport_Click" IsEnabled="False" />
                    <Button x:Name="ProfileReload" Content="Recargar perfiles guardados" Click="ProfileReload_Click" />
                    <TextBlock Text="Importar añade copias y guarda un respaldo. No aplica ajustes al equipo." TextWrapping="Wrap" FontSize="12" />
                  </StackPanel>
                </local:DetailsCard>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <local:DetailsCard Title="Rendimiento del perfil" Description="Edita potencia, CPU y valores independientes para cargador y batería.">
                <StackPanel>
                  <Button Content="Copiar las últimas lecturas al editor" Click="ProfileCapture_Click" />
                  <ComboBox x:Name="ProfileMode" Header="Modo Lenovo" SelectedIndex="0">
                    <ComboBoxItem Content="Sin cambiar" Tag="-1" />
                    <ComboBoxItem Content="Silencioso" Tag="1" />
                    <ComboBoxItem Content="Equilibrado" Tag="2" />
                    <ComboBoxItem Content="Rendimiento" Tag="3" />
                    <ComboBoxItem Content="Personalizado" Tag="255" />
                  </ComboBox>
                  <TextBlock Text="Estos límites se aplican solo al elegir Personalizado." TextWrapping="Wrap" FontSize="12" />
                  <Slider x:Name="ProfileSpl" Header="SPL (W)" Minimum="5" Maximum="30" Value="15" StepFrequency="1" />
                  <Slider x:Name="ProfileSppt" Header="SPPT (W)" Minimum="5" Maximum="30" Value="15" StepFrequency="1" />
                  <Slider x:Name="ProfileFppt" Header="FPPT (W)" Minimum="5" Maximum="30" Value="15" StepFrequency="1" />
                  <ComboBox x:Name="ProfileBoostAC" Header="Boost con cargador" SelectedIndex="0">
                    <ComboBoxItem Content="Sin cambiar" />
                    <ComboBoxItem Content="Desactivado" />
                    <ComboBoxItem Content="Activado" />
                  </ComboBox>
                  <CheckBox x:Name="ProfileEppACIncluded" Content="Aplicar EPP con cargador" />
                  <Slider x:Name="ProfileEppAC" Header="EPP AC" Minimum="0" Maximum="100" StepFrequency="1" Value="30" />
                  <ComboBox x:Name="ProfileBoostDC" Header="Boost en batería" SelectedIndex="0">
                    <ComboBoxItem Content="Sin cambiar" />
                    <ComboBoxItem Content="Desactivado" />
                    <ComboBoxItem Content="Activado" />
                  </ComboBox>
                  <CheckBox x:Name="ProfileEppDCIncluded" Content="Aplicar EPP en batería" />
                  <Slider x:Name="ProfileEppDC" Header="EPP DC" Minimum="0" Maximum="100" StepFrequency="1" Value="30" />
                  <ComboBox x:Name="ProfileWindows" Header="Modo Windows" SelectedIndex="0">
                    <ComboBoxItem Content="Sin cambiar" />
                    <ComboBoxItem Content="Máxima eficiencia" />
                    <ComboBoxItem Content="Equilibrado" />
                    <ComboBoxItem Content="Máximo rendimiento" />
                  </ComboBox>
                </StackPanel>
              </local:DetailsCard>
            </Border>
            <Border Style="{StaticResource Card}">
              <local:DetailsCard Title="Mando del perfil" Description="Distribución, zonas muertas y guardado del perfil.">
                <StackPanel>
                  <ComboBox x:Name="ProfileControllerMode" Header="Al aplicar este perfil" SelectedIndex="0">
                    <ComboBoxItem Content="Conservar el mando actual" />
                    <ComboBoxItem Content="Usar mando físico" />
                    <ComboBoxItem Content="Activar Xbox 360 virtual" />
                  </ComboBox>
                  <TextBlock Text="Requiere ViGEmBus y HidHide. Actívalo antes de abrir el juego, con otros remapeadores cerrados. La distribución siguiente se guarda con este perfil." TextWrapping="Wrap" FontSize="12" />
                  <StackPanel x:Name="ButtonMappings" />
                  <TextBlock Text="Botones especiales Legion" Style="{StaticResource SectionTitle}" Margin="0,12,0,0" />
                  <TextBlock Text="Legion L/R pueden enviar un botón Xbox. El atajo de Game Bar tiene prioridad. Las asignaciones traseras estarán disponibles después de identificar sus señales." TextWrapping="Wrap" FontSize="12" />
                  <StackPanel x:Name="LegionButtonMappings" />
                  <Slider x:Name="ProfileLeftDeadzone" Header="Zona muerta stick izquierdo (%)" Minimum="0" Maximum="30" StepFrequency="1" Value="10" />
                  <Slider x:Name="ProfileRightDeadzone" Header="Zona muerta stick derecho (%)" Minimum="0" Maximum="30" StepFrequency="1" Value="10" />
                  <CheckBox x:Name="ProfileSwapSticks" Content="Intercambiar sticks" />
                  <CheckBox x:Name="ProfileInvertLeft" Content="Invertir eje Y izquierdo" />
                  <CheckBox x:Name="ProfileInvertRight" Content="Invertir eje Y derecho" />
                  <CheckBox x:Name="ProfileSwapTriggers" Content="Intercambiar LT y RT" />
                  <Slider x:Name="ProfileRumble" Header="Vibración (%)" Minimum="0" Maximum="100" StepFrequency="1" Value="100" />
                  <Button x:Name="ProfileControllerReset" Content="Restablecer ajustes del mando en el borrador" Click="ProfileControllerReset_Click" IsEnabled="False" />
                  <TextBlock Text="Para salir de la emulación: mantén LB + RB + Back + Start durante 2 segundos, o usa Devolver mando físico en la pestaña Mando." TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
              </local:DetailsCard>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem Header="Juegos" x:Name="GamesTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" BringIntoViewOnFocusChange="True">
          <StackPanel Padding="0,4,0,12">
            <Border Style="{StaticResource Card}">
              <local:DetailsCard Title="OptiScaler" Description="Atajo del menú para juegos que ya usan OptiScaler.">
                <StackPanel Spacing="8">
                  <TextBlock Text="Con el juego activo, abre Game Bar y pulsa este botón. Se cierra Game Bar y se envía Insert a la ventana que recupera el foco. Requiere OptiScaler ya instalado en ese juego y su atajo Insert configurado." TextWrapping="Wrap" FontSize="12" />
                  <Button x:Name="OptiScalerMenu" Content="Abrir menú de OptiScaler (Insert)" Click="OptiScalerMenu_Click" IsEnabled="False" />
                  <TextBlock x:Name="OptiScalerText" Text="Consulta el helper desde Game Bar para habilitar el acceso." TextWrapping="Wrap" FontSize="12" />
                  <TextBlock Text="Este acceso no instala DLL ni cambia la configuración de FSR. El envío del atajo no confirma qué escalador está usando el juego." TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
              </local:DetailsCard>
            </Border>
            <Border Style="{StaticResource Card}">
              <local:DetailsCard Title="Accesos compatibles por juego" Description="Guarda accesos y exporta su configuración.">
                <StackPanel Spacing="8">
                  <TextBlock Text="Guarda el ejecutable y genera un acceso para abrir ese juego con las opciones elegidas. La selección y el guardado no abren el juego." TextWrapping="Wrap" FontSize="12" />
                  <ComboBox x:Name="GameAccessList" Header="Juego guardado" DisplayMemberPath="Name" SelectionChanged="GameAccessSelection_Changed" />
                  <Button Content="Nuevo juego" Click="GameAccessNew_Click" />
                  <TextBox x:Name="GameAccessName" Header="Nombre del juego" MaxLength="80" />
                  <TextBlock x:Name="GameAccessPath" Text="Selecciona el ejecutable del juego." TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" />
                  <Button Content="Seleccionar ejecutable" Click="GameAccessPick_Click" />
                  <ToggleSwitch x:Name="GameAccessRawInput" Header="Evitar entrada duplicada de SDL" />
                  <TextBlock Text="Desactiva Raw Input de SDL solo al abrir este acceso. Comprobado en BG3 con un virtual; otros juegos requieren su propia prueba. Para MD2, la solución comprobada es desactivar la traducción de Steam Input del escritorio." TextWrapping="Wrap" FontSize="12" />
                  <Button x:Name="GameAccessSave" Content="Guardar configuración del juego" Click="GameAccessSave_Click" />
                  <Button x:Name="GameAccessExport" Content="Generar acceso compatible" Click="GameAccessExport_Click" IsEnabled="False" />
                  <TextBlock x:Name="GameAccessText" TextWrapping="Wrap" FontSize="12" />
                  <TextBlock Text="Selecciona y genera el acceso desde la app de escritorio. Abre después el archivo .cmd guardado para iniciar el juego. Los accesos anteriores y los inicios desde otra biblioteca conservan su propia configuración." TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
              </local:DetailsCard>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel Spacing="8">
                <TextBlock Text="Lossless Scaling" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="LosslessText" Text="Pulsa Consultar para comprobar la instalación y si está abierto." TextWrapping="Wrap" />
                <Button x:Name="LosslessInspect" Content="Consultar Lossless Scaling" Click="LosslessInspect_Click" IsEnabled="False" />
                <Button x:Name="LosslessOpen" Content="Abrir Lossless Scaling" Click="LosslessOpen_Click" IsEnabled="False" />
                <TextBlock x:Name="LosslessActionText" TextWrapping="Wrap" FontSize="12" />
                <TextBlock Text="Abre tu instalación mediante Steam. Estar en ejecución no confirma que el escalado o la generación de fotogramas estén activos. Configura esos ajustes en Lossless Scaling." TextWrapping="Wrap" FontSize="12" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem Header="Ajustes" x:Name="SystemTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" BringIntoViewOnFocusChange="True">
          <StackPanel Padding="0,4,0,12">
            <Border Style="{StaticResource Card}">
              <local:DetailsCard Title="Registro de sesiones" Description="Graba lecturas, consulta un CSV o revisa las pruebas de continuidad." x:Name="RecordingDetails">
                <StackPanel>
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="Grabar una sesión" Style="{StaticResource SectionTitle}" />
                      <TextBlock Text="Guarda lecturas y ajustes en CSV cada 2 segundos. Continúa al cerrar Game Bar; vuelve aquí para detenerlo." TextWrapping="Wrap" />
                      <TextBlock x:Name="RecordingText" Text="Consultando el registro…" TextWrapping="Wrap" Margin="0,10,0,8" />
                      <Button x:Name="RecordStart" Content="Iniciar registro" Click="RecordStart_Click" IsEnabled="False" />
                      <Button x:Name="RecordStop" Content="Detener registro" Click="RecordStop_Click" IsEnabled="False" />
                      <Button x:Name="RecordOpen" Content="Abrir carpeta de registros" Click="RecordOpen_Click" IsEnabled="False" />
                      <TextBlock x:Name="RecordingPath" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Resumen de una sesión CSV" Style="{StaticResource SectionTitle}" />
                      <TextBlock Text="Selecciona un registro guardado para ver sus muestras válidas, temperaturas, consumo y huecos de lectura. El promedio es por muestras; no estima FPS ni autonomía." TextWrapping="Wrap" />
                      <Button x:Name="SessionSummaryOpen" Content="Abrir CSV y calcular resumen" Click="SessionSummaryOpen_Click" />
                      <Button x:Name="SessionSummaryCancel" Content="Cancelar análisis" Click="SessionSummaryCancel_Click" IsEnabled="False" />
                      <TextBlock x:Name="SessionSummaryText" Text="No hay una sesión seleccionada. El archivo se abre solo cuando lo pides." TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="Pruebas de continuidad" Style="{StaticResource SectionTitle}" />
                      <TextBlock Text="Inicia una sesión, juega, desconecta y conecta el cargador y prueba suspender y reanudar. El CSV marca los cambios observados y los intervalos sin muestras. Durante la suspensión no hay lecturas." TextWrapping="Wrap" />
                      <TextBlock Text="Cada sesión termina al detenerla, cerrar el helper o alcanzar 8 horas o 64 MiB. Tras reiniciar Windows, inicia una nueva sesión. Las lecturas no disponibles quedan vacías y conservan su error." TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </local:DetailsCard>
            </Border>
            <Border Style="{StaticResource Card}">
              <local:DetailsCard Title="Diagnóstico" Description="Consulta el helper y las capacidades disponibles.">
                <StackPanel Spacing="8">
                  <TextBlock x:Name="DiagnosticText" Text="Pulsa Consultar para obtener el estado del helper y su recuperación." TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" />
                  <Button Content="Consultar diagnóstico" Click="DiagnosticRefresh_Click" />
                  <Button Content="Copiar diagnóstico" Click="DiagnosticCopy_Click" />
                  <Button Content="Exportar diagnóstico a JSON" Click="DiagnosticExport_Click" />
                  <TextBlock Text="Consulta el estado y el último resultado sin iniciar ni reconectar el mando. El informe se copia o guarda solo cuando lo pides." TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
              </local:DetailsCard>
            </Border>
            <Border Style="{StaticResource Card}">
              <local:DetailsCard Title="Servicio de Legion Space" Description="Consulta el servicio OEM o solicita un cambio explícito.">
                <StackPanel>
                  <TextBlock x:Name="SpaceStatusText" Text="Estado sin consultar." TextWrapping="Wrap" />
                  <Button Content="Consultar Legion Space" Click="SpaceRefresh_Click" />
                  <Button x:Name="SpaceDisable" Content="Detener y deshabilitar servicio" Click="SpaceDisable_Click" IsEnabled="False" />
                  <Button x:Name="SpaceStart" Content="Iniciar servicio con arranque manual" Click="SpaceStart_Click" IsEnabled="False" />
                  <Button x:Name="SpaceRestore" Content="Restaurar estado guardado de Legion Space" Click="SpaceRestore_Click" IsEnabled="False" />
                  <TextBlock Text="Solo cambia DAService al pulsar un botón. No abre la aplicación. LegionTweaks no lo reactiva al cerrar, actualizar o desinstalar; la restauración de energía no lo modifica." TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
              </local:DetailsCard>
            </Border>
            <Border Style="{StaticResource Card}">
              <local:DetailsCard Title="Restaurar ajustes" Description="Revisa las opciones de recuperación antes de restaurar.">
                <StackPanel>
                  <TextBlock Text="Recupera los valores que este port guardó antes de sus primeras modificaciones. El respaldo se conserva entre reinicios." TextWrapping="Wrap" />
                  <Button Content="Restaurar valores originales" Click="Restore_Click" />
                </StackPanel>
              </local:DetailsCard>
            </Border>
            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="4,8">
              <Run Text="LegionTweaks Lab " />
              <Run x:Name="WidgetVersionRun" />
              <Run Text=" · Asignaciones Legion L/R, Y1/Y2/Y3 y M2/M3 por perfil; overlay RTSS opcional. Jugador 1 automático experimental; giroscopio y RGB pendientes." />
            </TextBlock>
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
    </Pivot>
  </Grid>
</Page>
