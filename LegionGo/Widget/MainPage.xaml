<Page x:Class="LegionTweaks.Widget.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBrush}">
  <Grid Padding="16" XYFocusKeyboardNavigation="Enabled">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="LegionTweaks Lab" FontSize="28" FontWeight="Bold"/>
      <TextBlock Text="LEGION GO · Z1 EXTREME · PORT EXPERIMENTAL" FontSize="11" Margin="0,4,0,10"/>
      <TextBlock x:Name="DeviceText" Text="Conectando…" TextWrapping="Wrap"/>
      <TextBlock x:Name="MetricsText" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,8,0,8">
      <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"/>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="13"/>
      <Button x:Name="RefreshButton" Content="Actualizar lecturas" Click="Refresh_Click"/>
      <Button Content="Abrir overlay del juego" Click="Overlay_Click"/>
    </StackPanel>
    <Pivot x:Name="Controls" Grid.Row="2" IsEnabled="False">
      <PivotItem Header="Potencia">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Modo Lenovo" Style="{StaticResource SectionTitle}"/>
              <ComboBox x:Name="ModeBox" AutomationProperties.Name="Modo de potencia Lenovo">
                <ComboBoxItem Content="Silencioso" Tag="1"/><ComboBoxItem Content="Equilibrado" Tag="2"/><ComboBoxItem Content="Rendimiento" Tag="3"/><ComboBoxItem Content="Personalizado" Tag="255"/>
              </ComboBox>
              <Button x:Name="ModeApply" Content="Aplicar modo" Click="Mode_Click"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Límites personalizados" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="TdpLive" TextWrapping="Wrap"/>
              <Slider x:Name="Spl" Header="SPL · potencia sostenida (W)" Minimum="5" Maximum="30" StepFrequency="1" Value="15"/>
              <Slider x:Name="Sppt" Header="SPPT · impulso corto (W)" Minimum="5" Maximum="30" StepFrequency="1" Value="15"/>
              <Slider x:Name="Fppt" Header="FPPT · pico (W)" Minimum="5" Maximum="30" StepFrequency="1" Value="15"/>
              <TextBlock Text="5 ≤ SPL ≤ SPPT ≤ FPPT ≤ 30 W. Aplicar activa el modo Personalizado." TextWrapping="Wrap" FontSize="12"/>
              <Button x:Name="Equalize" Content="Igualar SPPT y FPPT a SPL" Click="Equalize_Click"/>
              <Button x:Name="TdpApply" Content="Aplicar los tres límites" Click="Tdp_Click"/>
            </StackPanel></Border>

          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem Header="CPU">
        <ScrollViewer><StackPanel>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Plan de energía activo" Style="{StaticResource SectionTitle}"/>
            <ComboBox x:Name="Source" SelectedIndex="0" SelectionChanged="Source_Changed" Header="Valores que deseas editar">
              <ComboBoxItem Content="Con cargador (AC)"/><ComboBoxItem Content="Con batería (DC)"/>
            </ComboBox>
            <TextBlock x:Name="CpuLive" TextWrapping="Wrap" Margin="0,8,0,8"/>
            <ToggleSwitch x:Name="Boost" Header="CPU Boost" OnContent="Activado" OffContent="Desactivado"/>
            <Button x:Name="BoostApply" Content="Aplicar Boost" Click="Boost_Click"/>
            <Slider x:Name="Epp" Header="EPP · 0 rendimiento / 100 ahorro" Minimum="0" Maximum="100" StepFrequency="1"/>
            <Button x:Name="EppApply" Content="Aplicar EPP" Click="Epp_Click"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Modo de energía Windows" Style="{StaticResource SectionTitle}"/>
            <ComboBox x:Name="OsMode" AutomationProperties.Name="Modo de energía Windows"><ComboBoxItem Content="Máxima eficiencia"/><ComboBoxItem Content="Equilibrado"/><ComboBoxItem Content="Máximo rendimiento"/></ComboBox>
            <Button x:Name="OsApply" Content="Aplicar modo Windows" Click="Os_Click"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </PivotItem>
      <PivotItem Header="Perfiles">
        <ScrollViewer><StackPanel>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Rendimiento y distribución del mando" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Guardar conserva tus ajustes; Aplicar cambia el equipo. La selección es manual." TextWrapping="Wrap"/>
            <ComboBox x:Name="Profiles" Header="Perfiles guardados" DisplayMemberPath="Name" SelectionChanged="ProfileSelection_Changed"/>
            <Button x:Name="ProfileApplyButton" Content="Aplicar perfil guardado" Click="ProfileApply_Click"/>
            <Button Content="Crear perfil nuevo" Click="ProfileNew_Click"/>
            <Button Content="Eliminar perfil seleccionado" Click="ProfileDelete_Click"/>
            <TextBox x:Name="ProfileName" Header="Nombre (editarlo permite renombrar)" MaxLength="40" XYFocusKeyboardNavigation="Disabled" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
            <Button x:Name="ProfileNameEditButton" Content="Editar nombre con teclado táctil" Click="ProfileNameEdit_Click"/>
            <Button x:Name="ProfileExport" Content="Exportar perfiles a JSON" Click="ProfileExport_Click" IsEnabled="False"/>
            <Button x:Name="ProfileImport" Content="Importar copias desde JSON" Click="ProfileImport_Click" IsEnabled="False"/>
            <Button x:Name="ProfileReload" Content="Recargar perfiles guardados" Click="ProfileReload_Click"/>
            <TextBlock Text="Importar añade copias y guarda un respaldo. No aplica ajustes al equipo." TextWrapping="Wrap" FontSize="12"/>
            <TextBlock x:Name="ProfileNotice" TextWrapping="Wrap" FontSize="12"/>
            <TextBlock x:Name="ProfileDraftNotice" TextWrapping="Wrap" FontSize="12"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Rendimiento del perfil" Style="{StaticResource SectionTitle}"/>
            <Button Content="Copiar las últimas lecturas al editor" Click="ProfileCapture_Click"/>
            <ComboBox x:Name="ProfileMode" Header="Modo Lenovo" SelectedIndex="0">
              <ComboBoxItem Content="Sin cambiar" Tag="-1"/><ComboBoxItem Content="Silencioso" Tag="1"/><ComboBoxItem Content="Equilibrado" Tag="2"/><ComboBoxItem Content="Rendimiento" Tag="3"/><ComboBoxItem Content="Personalizado" Tag="255"/>
            </ComboBox>
            <TextBlock Text="Estos límites se aplican solo al elegir Personalizado." TextWrapping="Wrap" FontSize="12"/>
            <Slider x:Name="ProfileSpl" Header="SPL (W)" Minimum="5" Maximum="30" Value="15" StepFrequency="1"/>
            <Slider x:Name="ProfileSppt" Header="SPPT (W)" Minimum="5" Maximum="30" Value="15" StepFrequency="1"/>
            <Slider x:Name="ProfileFppt" Header="FPPT (W)" Minimum="5" Maximum="30" Value="15" StepFrequency="1"/>
            <ComboBox x:Name="ProfileBoostAC" Header="Boost con cargador" SelectedIndex="0"><ComboBoxItem Content="Sin cambiar"/><ComboBoxItem Content="Desactivado"/><ComboBoxItem Content="Activado"/></ComboBox>
            <CheckBox x:Name="ProfileEppACIncluded" Content="Aplicar EPP con cargador"/>
            <Slider x:Name="ProfileEppAC" Header="EPP AC" Minimum="0" Maximum="100" StepFrequency="1" Value="30"/>
            <ComboBox x:Name="ProfileBoostDC" Header="Boost en batería" SelectedIndex="0"><ComboBoxItem Content="Sin cambiar"/><ComboBoxItem Content="Desactivado"/><ComboBoxItem Content="Activado"/></ComboBox>
            <CheckBox x:Name="ProfileEppDCIncluded" Content="Aplicar EPP en batería"/>
            <Slider x:Name="ProfileEppDC" Header="EPP DC" Minimum="0" Maximum="100" StepFrequency="1" Value="30"/>
            <ComboBox x:Name="ProfileWindows" Header="Modo Windows" SelectedIndex="0"><ComboBoxItem Content="Sin cambiar"/><ComboBoxItem Content="Máxima eficiencia"/><ComboBoxItem Content="Equilibrado"/><ComboBoxItem Content="Máximo rendimiento"/></ComboBox>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Mando del perfil" Style="{StaticResource SectionTitle}"/>
            <ComboBox x:Name="ProfileControllerMode" Header="Al aplicar este perfil" SelectedIndex="0"><ComboBoxItem Content="Conservar el mando actual"/><ComboBoxItem Content="Usar mando físico"/><ComboBoxItem Content="Activar Xbox 360 virtual"/></ComboBox>
            <TextBlock Text="Requiere ViGEmBus y HidHide. Actívalo antes de abrir el juego, con otros remapeadores cerrados. La distribución siguiente se guarda con este perfil." TextWrapping="Wrap" FontSize="12"/>
            <StackPanel x:Name="ButtonMappings"/>
            <Slider x:Name="ProfileLeftDeadzone" Header="Zona muerta stick izquierdo (%)" Minimum="0" Maximum="30" StepFrequency="1" Value="10"/>
            <Slider x:Name="ProfileRightDeadzone" Header="Zona muerta stick derecho (%)" Minimum="0" Maximum="30" StepFrequency="1" Value="10"/>
            <CheckBox x:Name="ProfileSwapSticks" Content="Intercambiar sticks"/>
            <CheckBox x:Name="ProfileInvertLeft" Content="Invertir eje Y izquierdo"/>
            <CheckBox x:Name="ProfileInvertRight" Content="Invertir eje Y derecho"/>
            <CheckBox x:Name="ProfileSwapTriggers" Content="Intercambiar LT y RT"/>
            <Slider x:Name="ProfileRumble" Header="Vibración (%)" Minimum="0" Maximum="100" StepFrequency="1" Value="100"/>
            <Button x:Name="ProfileSave" Content="Guardar cambios del perfil" Click="ProfileSave_Click"/>
            <TextBlock Text="Para salir de la emulación: mantén LB + RB + Back + Start durante 2 segundos, o usa Devolver mando físico en la pestaña Mando." TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </PivotItem>
      <PivotItem Header="Mando">
        <ScrollViewer><StackPanel>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Abrir y cerrar Game Bar" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Elige los botones especiales superiores Legion L/R. Funciona con el mando físico o virtual y conserva tu elección al reiniciar Windows." TextWrapping="Wrap"/>
            <ComboBox x:Name="ShortcutMode" Header="Botones para Game Bar" SelectedIndex="0">
              <ComboBoxItem Content="Desactivado"/><ComboBoxItem Content="Legion L"/><ComboBoxItem Content="Legion R"/><ComboBoxItem Content="Legion L + Legion R"/>
            </ComboBox>
            <Button x:Name="ShortcutApply" Content="Guardar atajo" Click="ShortcutApply_Click" IsEnabled="False"/>
            <TextBlock x:Name="ShortcutText" Text="Consultando botones Legion…" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock Text="Cada pulsación envía Win+G una vez. Si otra aplicación usa estos botones, desactiva su asignación para evitar abrir dos interfaces." TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Mando físico → distribución → Xbox virtual" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="ControllerText" Text="Consultando el mando…" TextWrapping="Wrap"/>
            <Button x:Name="ControllerPlayerOne" Content="Activar virtual como jugador 1 (automático)" Click="ControllerPlayerOne_Click" IsEnabled="False"/>
            <Button x:Name="ControllerPlayerOneFps" Content="Preparar jugador 1 con interruptor FPS" Click="ControllerPlayerOneFps_Click" IsEnabled="False"/>
            <TextBlock Text="Usa la distribución del perfil virtual guardado que seleccionaste en Perfiles, sin aplicar su energía. Cierra los juegos y Steam. El botón automático intenta reconectar la función XInput. La alternativa con FPS te pide activar el interruptor y volver a OFF cuando haga falta." TextWrapping="Wrap" FontSize="12"/>
            <Button x:Name="ControllerStopButton" Content="Devolver mando físico" Click="ControllerStop_Click"/>
            <Button Content="Actualizar estado del mando" Click="ControllerRefresh_Click"/>
            <TextBlock x:Name="ControllerInputText" TextWrapping="Wrap" Margin="0,12,0,0"/>
            <TextBlock x:Name="ControllerOutputText" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock Text="Con el virtual activo, el visor muestra la entrada y salida cada 2 segundos. Sin el virtual, no mide la entrada física. El helper continúa con Game Bar cerrada; dispones de 90 segundos para completar los pasos FPS." TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
            <TextBlock Text="Esta versión admite botones estándar, sticks y gatillos. Después de suspender o desconectar los mandos, aplica de nuevo el perfil. La asignación automática por juego llegará después." TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel Spacing="8">
            <TextBlock Text="Mouse con stick derecho" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="MouseText" Text="Apagado. Requiere el mando virtual activo." TextWrapping="Wrap"/>
            <Button x:Name="MouseToggle" Content="Activar mouse con stick derecho" Click="MouseToggle_Click" IsEnabled="False"/>
            <Slider x:Name="MouseSensitivity" Header="Sensibilidad" Minimum="1" Maximum="20" Value="8" StepFrequency="1"/>
            <Slider x:Name="MouseDeadzone" Header="Zona muerta (%)" Minimum="5" Maximum="30" Value="15" StepFrequency="1"/>
            <Button x:Name="MouseSettings" Content="Aplicar ajustes del mouse" Click="MouseSettings_Click" IsEnabled="False"/>
            <TextBlock Text="Solo mueve el cursor con el virtual activo; consume el stick derecho para evitar mover también la cámara y no añade clics. Al activarlo, suelta el stick para armarlo. Se apaga al iniciar, devolver el físico, suspender o desconectar." TextWrapping="Wrap" FontSize="12"/>
            <TextBlock Text="Si otra aplicación también controla el cursor, desactiva esa función antes de usar este modo." TextWrapping="Wrap" FontSize="12"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </PivotItem>
      <PivotItem Header="Registro">
        <ScrollViewer><StackPanel>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Grabar una sesión" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Guarda lecturas y ajustes en CSV cada 2 segundos. Continúa al cerrar Game Bar; vuelve aquí para detenerlo." TextWrapping="Wrap"/>
            <TextBlock x:Name="RecordingText" Text="Consultando el registro…" TextWrapping="Wrap" Margin="0,10,0,8"/>
            <Button x:Name="RecordStart" Content="Iniciar registro" Click="RecordStart_Click" IsEnabled="False"/>
            <Button x:Name="RecordStop" Content="Detener registro" Click="RecordStop_Click" IsEnabled="False"/>
            <Button x:Name="RecordOpen" Content="Abrir carpeta de registros" Click="RecordOpen_Click" IsEnabled="False"/>
            <TextBlock x:Name="RecordingPath" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Margin="0,8,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Pruebas de continuidad" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Inicia una sesión, juega, desconecta y conecta el cargador y prueba suspender y reanudar. El CSV marca los cambios observados y los intervalos sin muestras. Durante la suspensión no hay lecturas." TextWrapping="Wrap"/>
            <TextBlock Text="Cada sesión termina al detenerla, cerrar el helper o alcanzar 8 horas o 64 MiB. Tras reiniciar Windows, inicia una nueva sesión. Las lecturas no disponibles quedan vacías y conservan su error." TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </PivotItem>
      <PivotItem Header="Sistema">
        <ScrollViewer><StackPanel>
          <Border Style="{StaticResource Card}"><StackPanel Spacing="8">
            <TextBlock Text="Diagnóstico" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="DiagnosticText" Text="Pulsa Consultar para obtener el estado del helper y su recuperación." TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/>
            <Button Content="Consultar diagnóstico" Click="DiagnosticRefresh_Click"/>
            <Button Content="Copiar diagnóstico" Click="DiagnosticCopy_Click"/>
            <Button Content="Exportar diagnóstico a JSON" Click="DiagnosticExport_Click"/>
            <TextBlock Text="Consulta el estado y el último resultado sin iniciar ni reconectar el mando. El informe se copia o guarda solo cuando lo pides." TextWrapping="Wrap" FontSize="12"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Servicio de Legion Space" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="SpaceStatusText" Text="Estado sin consultar." TextWrapping="Wrap"/>
            <Button Content="Consultar Legion Space" Click="SpaceRefresh_Click"/>
            <Button x:Name="SpaceDisable" Content="Detener y deshabilitar servicio" Click="SpaceDisable_Click" IsEnabled="False"/>
            <Button x:Name="SpaceStart" Content="Iniciar servicio con arranque manual" Click="SpaceStart_Click" IsEnabled="False"/>
            <Button x:Name="SpaceRestore" Content="Restaurar estado guardado de Legion Space" Click="SpaceRestore_Click" IsEnabled="False"/>
            <TextBlock Text="Solo cambia DAService al pulsar un botón. No abre la aplicación. LegionTweaks no lo reactiva al cerrar, actualizar o desinstalar; la restauración de energía no lo modifica." TextWrapping="Wrap" FontSize="12"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Ventilador y batería" Style="{StaticResource SectionTitle}"/>
            <ToggleSwitch x:Name="Fan" Header="Ventilador a máxima velocidad" OnContent="Máximo" OffContent="Automático"/>
            <Button x:Name="FanApply" Content="Aplicar ventilador" Click="Fan_Click"/>
            <ToggleSwitch x:Name="Charge" Header="Limitar carga al 80 %"/>
            <Button x:Name="ChargeApply" Content="Aplicar límite de carga" Click="Charge_Click"/>
            <ToggleSwitch x:Name="Light" Header="Luz del botón de encendido"/>
            <Button x:Name="LightApply" Content="Aplicar luz" Click="Light_Click"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Restaurar ajustes" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Recupera los valores que este port guardó antes de sus primeras modificaciones. El respaldo se conserva entre reinicios." TextWrapping="Wrap"/>
            <Button Content="Restaurar valores originales" Click="Restore_Click"/>
          </StackPanel></Border>
          <TextBlock Text="LegionTweaks Lab 0.1.15 · Mouse con stick derecho, diagnóstico y protección de borradores. Jugador 1 automático experimental; giroscopio, botones traseros, RGB y RTSS pendientes." TextWrapping="Wrap" FontSize="12" Margin="4,8"/>
        </StackPanel></ScrollViewer>
      </PivotItem>
    </Pivot>
  </Grid>
</Page>
