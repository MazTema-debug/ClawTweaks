<Page x:Class="LegionTweaks.Widget.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:LegionTweaks.Widget" xmlns:primitives="using:Windows.UI.Xaml.Controls.Primitives" RequestedTheme="Dark" Background="#25282C">
  <Page.Resources>
    <!-- GoTweaks MIT visual port, commit 99ed5f5f8c22bb78bfffee9b37f9a04094f30482. Copyright (c) Microsoft Corporation. See LICENSE.GoTweaks and SOURCES.md. Resources are instantiated independently for each view. -->
    <SolidColorBrush x:Key="SystemAccentBrush" Color="{ThemeResource SystemAccentColorLight2}" />
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#25282C" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#30343A" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#50555C" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#3E434B" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#484E58" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3A3F47" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#2C3035" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#6B7584" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#6B7584" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#555D69" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#3A3F46" />
    <SolidColorBrush x:Key="CardFocusBorderBrush" Color="White" />
    <SolidColorBrush x:Key="TileOffBackground" Color="#1A1C1E" />
    <SolidColorBrush x:Key="TileInactiveForeground" Color="#606060" />
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    </Style>
    <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#AAAAAA" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="8,5,8,5" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <!-- System focus visuals OFF: the template draws its own rounded FocusBorder
                 via the Focused visual state below — enabling system visuals on top
                 stacked a second square rect over it (field feedback 2026-07-28). The
                 first-open invisible-focus bug was the missing focus ANCHOR (fixed in
                 WidgetEvents/Navigation with FocusState.Keyboard), not these visuals. -->
      <Setter Property="UseSystemFocusVisuals" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <Storyboard>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFF" />
                      </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="#888888" />
                      </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <Storyboard>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="#555555" />
                      </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                  <VisualState x:Name="Checked">
                    <Storyboard>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SystemAccentBrush}" />
                      </ObjectAnimationUsingKeyFrames>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                      </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Unchecked" />
                  <VisualState x:Name="Indeterminate" />
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                  <VisualState x:Name="Focused">
                    <Storyboard>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusBorder" Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                      </ObjectAnimationUsingKeyFrames>
                      <!-- Dark text on the light pill so the label stays readable -->
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="#1A1A1A" />
                      </ObjectAnimationUsingKeyFrames>
                      <!-- Underline goes dark too — accent-on-light is hard to read -->
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Background">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="#1A1A1A" />
                      </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Unfocused" />
                  <VisualState x:Name="PointerFocused" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <!-- Focused pill: filled rounded light background (replaces the
                                 old white outline ring). Margin 0 = fill hugs the pill
                                 bounds instead of bleeding into the strip spacing. -->
              <Border x:Name="FocusBorder" Background="#E8E8E8" CornerRadius="6" Margin="0" Visibility="Collapsed" />
              <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
              <Border x:Name="SelectionIndicator" Height="3" Background="{StaticResource SystemAccentBrush}" CornerRadius="1.5" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="6,0,6,2" Visibility="Collapsed" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QuickSettingsTileStyle" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource TileOffBackground}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="12,16" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="60" />
      <Setter Property="MinHeight" Value="90" />
      <Setter Property="UseSystemFocusVisuals" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver" />
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                      </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <Storyboard>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="InactiveOverlay" Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                      </ObjectAnimationUsingKeyFrames>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TileInactiveForeground}" />
                      </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                  <VisualState x:Name="Focused">
                    <Storyboard>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusBorder" Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                      </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Unfocused" />
                  <VisualState x:Name="PointerFocused" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <!-- Background with light border -->
              <Border x:Name="BackgroundBorder" Background="{TemplateBinding Background}" BorderBrush="#50555C" BorderThickness="1" CornerRadius="12" />
              <!-- Pressed overlay (10% darker) -->
              <Border x:Name="PressedOverlay" Background="#1A000000" CornerRadius="12" Visibility="Collapsed" />
              <!-- Inactive overlay (50% darker) -->
              <Border x:Name="InactiveOverlay" Background="#80000000" CornerRadius="12" Visibility="Collapsed" />
              <!-- Focus stroke border -->
              <Border x:Name="FocusBorder" BorderBrush="White" BorderThickness="2" CornerRadius="12" Visibility="Collapsed" />
              <!-- Content -->
              <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource CardStyle}">
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Tag" Value="ShellCard" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Margin" Value="0,4,6,4" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
  </Page.Resources>
  <Grid x:Name="ShellRoot" Padding="12" XYFocusKeyboardNavigation="Enabled" SizeChanged="Shell_SizeChanged">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid x:Name="ShellHeader" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="LegionTweaks" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="ShellAreaText" FontSize="13" Foreground="{StaticResource SystemAccentBrush}" />
        <TextBlock Text="LEGION GO · Z1 EXTREME" FontSize="10" Foreground="#C0C6CF" />
      </StackPanel>
      <Button x:Name="RefreshButton" Content="" Click="Refresh_Click" FontFamily="Segoe MDL2 Assets" Grid.Column="1" MinWidth="44" Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Actualizar lecturas" ToolTipService.ToolTip="Actualizar lecturas" />
    </Grid>
    <ContentControl x:Name="ShellNavigationSurface" Grid.Row="1" IsTabStop="False" HorizontalContentAlignment="Stretch">
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Content="LT" Tag="previous" Click="Shell_StepClick" MinWidth="44" Margin="0,0,6,0" HorizontalContentAlignment="Center" AutomationProperties.Name="Área anterior, gatillo izquierdo" ToolTipService.ToolTip="Área anterior (LT)" />
        <Grid x:Name="ShellNavigationHost" Grid.Column="1" SizeChanged="Shell_SizeChanged">
          <Grid x:Name="ShellNavigationGrid">
            <RadioButton x:Name="HomeNav" Content="Inicio" Tag="Home" GroupName="ShellAreas" Style="{StaticResource NavRadioButtonStyle}" HorizontalAlignment="Stretch" Checked="Shell_NavChecked" AutomationProperties.Name="Abrir Inicio" />
            <RadioButton x:Name="PowerNav" Content="Potencia" Tag="Power" GroupName="ShellAreas" Style="{StaticResource NavRadioButtonStyle}" HorizontalAlignment="Stretch" Checked="Shell_NavChecked" AutomationProperties.Name="Abrir Potencia" />
            <RadioButton x:Name="DisplayNav" Content="Pantalla" Tag="Display" GroupName="ShellAreas" Style="{StaticResource NavRadioButtonStyle}" HorizontalAlignment="Stretch" Checked="Shell_NavChecked" AutomationProperties.Name="Abrir Pantalla" />
            <RadioButton x:Name="ControllerNav" Content="Mando" Tag="Controller" GroupName="ShellAreas" Style="{StaticResource NavRadioButtonStyle}" HorizontalAlignment="Stretch" Checked="Shell_NavChecked" AutomationProperties.Name="Abrir Mando" />
            <RadioButton x:Name="ProfilesNav" Content="Perfiles" Tag="Profiles" GroupName="ShellAreas" Style="{StaticResource NavRadioButtonStyle}" HorizontalAlignment="Stretch" Checked="Shell_NavChecked" AutomationProperties.Name="Abrir Perfiles" />
            <RadioButton x:Name="GamesNav" Content="Juegos" Tag="Games" GroupName="ShellAreas" Style="{StaticResource NavRadioButtonStyle}" HorizontalAlignment="Stretch" Checked="Shell_NavChecked" AutomationProperties.Name="Abrir Juegos" />
            <RadioButton x:Name="SettingsNav" Content="Ajustes" Tag="Settings" GroupName="ShellAreas" Style="{StaticResource NavRadioButtonStyle}" HorizontalAlignment="Stretch" Checked="Shell_NavChecked" AutomationProperties.Name="Abrir Ajustes" />
          </Grid>
          <ComboBox x:Name="ShellSectionPicker" SelectionChanged="Shell_SectionChanged" AutomationProperties.Name="Área de LegionTweaks" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
        <Button Grid.Column="2" Content="RT" Tag="next" Click="Shell_StepClick" MinWidth="44" Margin="6,0,0,0" HorizontalContentAlignment="Center" AutomationProperties.Name="Área siguiente, gatillo derecho" ToolTipService.ToolTip="Área siguiente (RT)" />
      </Grid>
    </ContentControl>
    <Grid x:Name="ShellStatus" Grid.Row="2" Margin="0,0,0,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Row="1" Grid.Column="1" Content="Detalles" Click="Shell_StatusDetails" Margin="8,0,0,0" FontSize="12" />
      <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed" Grid.ColumnSpan="2" Height="3" />
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="13" Grid.Row="1" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
    </Grid>
    <Pivot x:Name="Controls" Grid.Row="3" IsEnabled="False" Margin="0">
      <Pivot.Resources>
        <Style TargetType="primitives:PivotHeaderItem">
          <Setter Property="Visibility" Value="Collapsed" />
        </Style>
      </Pivot.Resources>
      <PivotItem Header="Inicio" x:Name="HomeTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" BringIntoViewOnFocusChange="True">
          <StackPanel Padding="0,4,0,12">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Tu Legion de un vistazo" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="MetricsText" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="MetricAgeText" Text="Sin una lectura del equipo confirmada." TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <TextBlock Text="Accesos rápidos" Style="{StaticResource SectionTitle}" Margin="0,4,0,4" />
            <Grid x:Name="HomeTilesGrid" SizeChanged="Shell_SizeChanged">
              <Button Style="{StaticResource QuickSettingsTileStyle}" Tag="Power" Click="Shell_TileClick" Margin="0,0,8,8" AutomationProperties.Name="Abrir Potencia">
                <StackPanel Spacing="6">
                  <FontIcon Glyph="" FontSize="24" />
                  <TextBlock Text="Potencia" FontWeight="SemiBold" TextAlignment="Center" />
                  <TextBlock Text="TDP y CPU" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource QuickSettingsTileStyle}" Tag="Display" Click="Shell_TileClick" Margin="0,0,8,8" AutomationProperties.Name="Abrir Pantalla">
                <StackPanel Spacing="6">
                  <FontIcon Glyph="" FontSize="24" />
                  <TextBlock Text="Pantalla" FontWeight="SemiBold" TextAlignment="Center" />
                  <TextBlock Text="Resolución y AMD" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource QuickSettingsTileStyle}" Tag="Controller" Click="Shell_TileClick" Margin="0,0,8,8" AutomationProperties.Name="Abrir Mando">
                <StackPanel Spacing="6">
                  <FontIcon Glyph="" FontSize="24" />
                  <TextBlock Text="Mando" FontWeight="SemiBold" TextAlignment="Center" />
                  <TextBlock Text="Estado y distribuciones" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource QuickSettingsTileStyle}" Tag="Profiles" Click="Shell_TileClick" Margin="0,0,8,8" AutomationProperties.Name="Abrir Perfiles">
                <StackPanel Spacing="6">
                  <FontIcon Glyph="" FontSize="24" />
                  <TextBlock Text="Perfiles" FontWeight="SemiBold" TextAlignment="Center" />
                  <TextBlock Text="Guardar y elegir" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource QuickSettingsTileStyle}" Tag="Games" Click="Shell_TileClick" Margin="0,0,8,8" AutomationProperties.Name="Abrir Juegos">
                <StackPanel Spacing="6">
                  <FontIcon Glyph="" FontSize="24" />
                  <TextBlock Text="Juegos" FontWeight="SemiBold" TextAlignment="Center" />
                  <TextBlock Text="Accesos y escalado" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource QuickSettingsTileStyle}" Tag="Overlay" Click="Shell_TileClick" Margin="0,0,8,8" AutomationProperties.Name="Abrir Overlay">
                <StackPanel Spacing="6">
                  <FontIcon Glyph="" FontSize="24" />
                  <TextBlock Text="Overlay" FontWeight="SemiBold" TextAlignment="Center" />
                  <TextBlock Text="Métricas en juego" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
            <TextBlock Text="Los accesos abren su pantalla. Aplica los cambios desde sus controles." FontSize="12" Foreground="#C0C6CF" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Button Content="Diagnóstico y registro" Tag="Settings" Click="Shell_TileClick" />
            <Border Style="{StaticResource Card}">
              <local:DetailsCard Title="Equipo" Description="Modelo y procesador consultados al helper.">
                <TextBlock x:Name="DeviceText" Text="Conectando…" TextWrapping="Wrap" />
              </local:DetailsCard>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem Header="Potencia" x:Name="PowerTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" BringIntoViewOnFocusChange="True">
          <StackPanel Padding="0,4,0,12">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Modo Lenovo" Style="{StaticResource SectionTitle}" />
                <ComboBox x:Name="ModeBox" AutomationProperties.Name="Modo de potencia Lenovo">
                  <ComboBoxItem Content="Silencioso" Tag="1" />
                  <ComboBoxItem Content="Equilibrado" Tag="2" />
                  <ComboBoxItem Content="Rendimiento" Tag="3" />
                  <ComboBoxItem Content="Personalizado" Tag="255" />
                </ComboBox>
                <Button x:Name="ModeApply" Content="Aplicar modo" Click="Mode_Click" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Límites personalizados" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="TdpLive" TextWrapping="Wrap" />
                <Slider x:Name="Spl" Header="SPL · potencia sostenida (W)" Minimum="5" Maximum="30" StepFrequency="1" Value="15" />
                <Slider x:Name="Sppt" Header="SPPT · impulso corto (W)" Minimum="5" Maximum="30" StepFrequency="1" Value="15" />
                <Slider x:Name="Fppt" Header="FPPT · pico (W)" Minimum="5" Maximum="30" StepFrequency="1" Value="15" />
                <TextBlock Text="5 ≤ SPL ≤ SPPT ≤ FPPT ≤ 30 W. Aplicar activa el modo Personalizado." TextWrapping="Wrap" FontSize="12" />
                <Button x:Name="Equalize" Content="Igualar SPPT y FPPT a SPL" Click="Equalize_Click" />
                <Button x:Name="TdpApply" Content="Aplicar los tres límites" Click="Tdp_Click" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Plan de energía activo" Style="{StaticResource SectionTitle}" />
                <ComboBox x:Name="Source" SelectedIndex="0" SelectionChanged="Source_Changed" Header="Valores que deseas editar">
                  <ComboBoxItem Content="Con cargador (AC)" />
                  <ComboBoxItem Content="Con batería (DC)" />
                </ComboBox>
                <TextBlock x:Name="CpuLive" TextWrapping="Wrap" Margin="0,8,0,8" />
                <ToggleSwitch x:Name="Boost" Header="CPU Boost" OnContent="Activado" OffContent="Desactivado" />
                <Button x:Name="BoostApply" Content="Aplicar Boost" Click="Boost_Click" />
                <Slider x:Name="Epp" Header="EPP · 0 rendimiento / 100 ahorro" Minimum="0" Maximum="100" StepFrequency="1" />
                <Button x:Name="EppApply" Content="Aplicar EPP" Click="Epp_Click" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Modo de energía Windows" Style="{StaticResource SectionTitle}" />
                <ComboBox x:Name="OsMode" AutomationProperties.Name="Modo de energía Windows">
                  <ComboBoxItem Content="Máxima eficiencia" />
                  <ComboBoxItem Content="Equilibrado" />
                  <ComboBoxItem Content="Máximo rendimiento" />
                </ComboBox>
                <Button x:Name="OsApply" Content="Aplicar modo Windows" Click="Os_Click" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <local:DetailsCard Title="Ventilador y batería" Description="Ventilador máximo, límite de carga e iluminación." x:Name="CoolingDetails">
                <StackPanel>
                  <ToggleSwitch x:Name="Fan" Header="Ventilador a máxima velocidad" OnContent="Máximo" OffContent="Automático" />
                  <Button x:Name="FanApply" Content="Aplicar ventilador" Click="Fan_Click" />
                  <ToggleSwitch x:Name="Charge" Header="Limitar carga al 80 %" />
                  <Button x:Name="ChargeApply" Content="Aplicar límite de carga" Click="Charge_Click" />
                  <ToggleSwitch x:Name="Light" Header="Luz del botón de encendido" />
                  <Button x:Name="LightApply" Content="Aplicar luz" Click="Light_Click" />
                </StackPanel>
              </local:DetailsCard>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem Header="Pantalla" x:Name="DisplayTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" BringIntoViewOnFocusChange="True">
          <StackPanel Padding="0,4,0,12">
            <Border Style="{StaticResource Card}">
              <StackPanel Spacing="8">
                <TextBlock Text="Pantalla" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="DisplayCurrentText" Text="Resolución actual sin confirmar" TextWrapping="Wrap" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="DisplayRefreshText" Text="Leyendo automáticamente resolución y frecuencia…" TextWrapping="Wrap" />
                <ComboBox x:Name="DisplayModesBox" Header="Cambiar resolución" AutomationProperties.Name="Resolución de pantalla. La selección aplica el cambio directamente." SelectionChanged="DisplayModesBox_SelectionChanged" IsEnabled="False" />
                <ComboBox x:Name="DisplayRefreshBox" Header="Frecuencia" AutomationProperties.Name="Frecuencia de pantalla: 60 o 144 Hz. La selección aplica el cambio directamente." SelectionChanged="DisplayRefreshBox_SelectionChanged" IsEnabled="False" />
                <TextBlock Text="La lectura se actualiza automáticamente. Selecciona resolución o 60/144 Hz para aplicar directamente. Cada selector conserva el otro ajuste; las opciones no disponibles aparecen deshabilitadas. Solo afecta a esta sesión de Windows y requiere una sola pantalla activa." TextWrapping="Wrap" FontSize="12" />
                <TextBlock x:Name="DisplayTrialText" Text="Sin cambios pendientes." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="DisplayRecover" Content="Recuperar cambio anterior pendiente" Click="DisplayRecover_Click" IsEnabled="False" Visibility="Collapsed" />
