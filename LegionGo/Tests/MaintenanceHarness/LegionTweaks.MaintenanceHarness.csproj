<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>Program</StartupObject>
    <AssemblyName>LegionTweaks.MaintenanceHarness</AssemblyName>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\..\Helper\*.cs" Link="Helper\%(Filename)%(Extension)" />
    <Compile Include="..\FpsY3ExclusiveGateTests.cs" Link="FpsY3ExclusiveGateTests.cs" />
    <Compile Include="..\FpsY3AdmissionTests.cs" Link="FpsY3AdmissionTests.cs" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <Reference Include="System.Management" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
</Project>
